{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "ghost/test/utils/fixtures/themes/**/assets/built/**",
    ".github/scripts/i18n-review/**"
  ],
  "ignoreBinaries": ["less"],
  "workspaces": {
    ".": {
      "vitest": {
        "config": []
      },
      "ignoreDependencies": [
        "lint-staged",
        "secretlint",
        "@secretlint/secretlint-rule-pattern",
        "@secretlint/secretlint-rule-preset-recommend",
        "markdownlint-cli2",
        "remark-cli",
        "remark-validate-links"
      ]
    },
    "ghost": {
      "ignoreDependencies": ["cssnano", "mysql"]
    },
    "apps/admin": {
      "entry": ["src/members/detail/map-data/generate-map.mjs"]
    },
    "apps/admin-x-framework": {
      "entry": ["src/api/*.ts"]
    },
    "apps/comments-ui": {
      "ignoreDependencies": ["eslint-plugin-tailwindcss"]
    },
    "apps/signup-form": {
      "ignoreDependencies": ["eslint-plugin-tailwindcss"]
    },
    "e2e": {
      "ignoreDependencies": ["@tryghost/checkout", "@tryghost/metafield-types"]
    },
    "koenig/koenig-lexical": {
      "ignoreDependencies": ["@storybook/react", "prettier-plugin-organize-attributes"]
    },
    "packages/app-sdk": {
      "ignoreDependencies": ["zod"]
    },
    "tools/configs/oxlint": {
      "entry": ["plugin.ts", "local-plugin.ts", "filenames-plugin.ts"]
    },
    "tools/gx": {
      "entry": ["*.ts"],
      "ignoreDependencies": ["@internal/scripts"]
    }
  }
}
