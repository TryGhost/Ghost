{
  "name": "@tryghost/kernel",
  "version": "private",
  "private": true,
  "description": "Stateless framework code: types, define utilities and pure functions that any code may import and call.",
  "license": "MIT",
  "author": "Ghost Foundation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryGhost/Ghost.git",
    "directory": "tbd/kernel"
  },
  "files": [
    "build"
  ],
  "type": "module",
  "exports": {
    "./adapter-manager": {
      "source": "./src/adapter-manager/index.ts",
      "types": "./build/adapter-manager/index.d.ts",
      "default": "./build/adapter-manager/index.js"
    },
    "./*": {
      "source": "./src/*.ts",
      "types": "./build/*.d.ts",
      "default": "./build/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test:unit": "NODE_ENV=testing vitest run --coverage",
    "test": "pnpm run '/^test:/'",
    "test:types": "tsc --noEmit -p test/tsconfig.json",
    "lint:code": "eslint src/ --cache",
    "lint:test": "eslint test/ --cache",
    "lint": "pnpm run '/^lint:/'"
  },
  "dependencies": {
    "@tryghost/errors": "catalog:",
    "moment-timezone": "catalog:",
    "temporal-polyfill": "catalog:"
  },
  "devDependencies": {
    "@internal/cfg-eslint": "workspace:*",
    "@internal/cfg-typescript": "workspace:*",
    "@internal/cfg-vitest": "workspace:*",
    "@types/node": "catalog:",
    "@types/sinon": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "knex": "catalog:",
    "sinon": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "ghostPackage": {
    "goldenPath": "compliant"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/build"
        ]
      }
    }
  }
}
