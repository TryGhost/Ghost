{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "jsPlugins": [
    {
      "name": "ghost",
      "specifier": "./tools/configs/oxlint/plugin.mjs"
    }
  ],
  "overrides": [
    {
      "files": ["ghost/core/server/**/*.{js,ts}"],
      "rules": {
        "ghost/ghost-custom/no-native-error": "error"
      }
    }
  ]
}
