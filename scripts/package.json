{
  "name": "@internal/scripts",
  "version": "0.0.0",
  "private": true,
  "description": "Repo automation scripts, invoked from CI workflows and local pnpm aliases",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "eslint . --cache",
    "test:unit": "node --test test/*.test.js test/*.test.cjs test/*.test.ts",
    "test": "pnpm run '/^test:/'",
    "test:types": "tsc6 --noEmit"
  },
  "dependencies": {
    "@octokit/core": "catalog:",
    "@octokit/plugin-retry": "catalog:",
    "@octokit/plugin-throttling": "catalog:",
    "@pnpm/releasing.versioning": "catalog:",
    "@pnpm/workspace.workspace-manifest-reader": "catalog:",
    "camelcase-keys": "10.0.3",
    "execa": "catalog:",
    "js-yaml": "catalog:",
    "picomatch": "4.0.5",
    "semver": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@internal/cfg-eslint": "workspace:*",
    "@internal/cfg-typescript": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:"
  }
}
