{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "arrowParens": "avoid",
    "bracketSpacing": false,
    "ignorePatterns": [
        "**/build/**",
        "**/built/**",
        "**/coverage/**",
        "**/dist/**",
        "**/*.min.*",
        "**/*.hbs",
        "**/*.html",
        "**/test/**/fixtures/**",
        "**/__snapshots__/**",
        "apps/ember-admin/**",
        "koenig/kg-default-nodes/**",
        "koenig/kg-lexical-html-renderer/**",
        "koenig/kg-simplemde/debug/**",
        "koenig/koenig-lexical/**"
    ],
    "jsdoc": {
        "addDefaultToDescription": false,
        "bracketSpacing": false
    },
    "jsxSingleQuote": true,
    "printWidth": 120,
    "singleQuote": true,
    "sortPackageJson": false,
    "tabWidth": 4,
    "trailingComma": "none",
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
