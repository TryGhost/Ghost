DESCRIPTION >
    Fetch runs in batches for member search; optionally restrict to all matching run IDs from Core.

NODE selected_runs
SQL >
    %
    {% if String(sort_direction, 'desc') not in ['asc', 'desc'] %}
        {{ error('sort_direction must be asc or desc') }}
    {% end %}
    {% if Int32(limit, 50) < 1 or Int32(limit, 50) > 5000 %}
        {{ error('limit must be between 1 and 5000') }}
    {% end %}
    {% if defined(after_created_at) != defined(after_id) %}
        {{ error('after_created_at and after_id must be supplied together') }}
    {% end %}
    {% if defined(run_ids) and (len(String(run_ids, '')) > 49999 or len(String(run_ids, '').split(',')) > 2000) %}
        {{ error('run_ids exceeds the complete-match limit') }}
    {% end %}
    SELECT id, created_at
    FROM _mv_automation_runs FINAL
    WHERE site_uuid = {{ String(site_uuid, required=True) }}
        AND automation_id = {{ String(automation_id, required=True) }}
        {% if defined(run_ids) %}
        AND id IN splitByChar(',', {{ String(run_ids, '') }})
        {% end %}

NODE run_status_flags
SQL >
    %
    SELECT
        automation_run_id,
        -- Same categories as api_automation_performance_stats, limited to the selected runs.
        groupBitOr(toUInt8(multiIf(
            status = 'pending', 1,
            status = 'finished', 2,
            status IN ('automation disabled', 'failed', 'member changed status', 'member unsubscribed'), 4,
            8
        ))) AS status_flags,
        max(status = 'failed') AS has_failed_step
    FROM _mv_automation_run_steps FINAL
    WHERE site_uuid = {{ String(site_uuid, required=True) }}
        AND automation_run_id IN (SELECT id FROM selected_runs)
    GROUP BY automation_run_id

NODE runs_with_status
SQL >
    SELECT
        runs.id AS id,
        formatDateTime(runs.created_at, '%Y-%m-%dT%H:%i:%S.%fZ', 'UTC') AS created_at,
        multiIf(
            bitAnd(flags.status_flags, 8) != 0, 'invalid',
            bitAnd(flags.status_flags, 1) != 0, 'in_progress',
            flags.status_flags = 2, 'completed',
            flags.status_flags IN (4, 6), 'exited_early',
            'invalid'
        ) AS status,
        toBool(status = 'exited_early' AND flags.has_failed_step) AS failed
    FROM selected_runs AS runs
    INNER JOIN run_status_flags AS flags ON flags.automation_run_id = runs.id

NODE matching_runs
SQL >
    %
    SELECT id, created_at, status, failed
    FROM runs_with_status
    -- Include invalid statuses for Core to check after matching the member.
    {% if defined(after_id) %}
        WHERE (parseDateTime64BestEffort(created_at, 3, 'UTC'), id)
            {% if String(sort_direction, 'desc') == 'asc' %} > {% else %} < {% end %}
            (parseDateTime64BestEffort({{ String(after_created_at, '') }}, 3, 'UTC'), {{ String(after_id, '') }})
    {% end %}
    {% if String(sort_direction, 'desc') == 'asc' %}
        ORDER BY created_at ASC, id ASC
    {% else %}
        ORDER BY created_at DESC, id DESC
    {% end %}
    LIMIT {{ Int32(limit, 50) }}
    SETTINGS max_execution_time = 2

TYPE ENDPOINT
