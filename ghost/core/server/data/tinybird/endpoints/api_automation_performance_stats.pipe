DESCRIPTION >
    Hourly or daily entries and current outcomes from the same recorded runs.

NODE selected_status_runs
SQL >
    %
    SELECT id, created_at
    FROM _mv_automation_runs FINAL
    WHERE site_uuid = {{ String(site_uuid, required=True) }}
        AND automation_id = {{ String(automation_id, required=True) }}
        {% if defined(date_from) %}
        AND created_at >= toDateTime64({{ String(date_from) }}, 3, {{ String(timezone, 'UTC') }})
        {% end %}
        {% if defined(date_to) %}
        AND created_at < toDateTime64({{ String(date_to) }}, 3, {{ String(timezone, 'UTC') }})
        {% end %}

NODE run_status_flags
SQL >
    %
    SELECT
        automation_run_id,
        -- Combine categories after FINAL has selected each step's latest version.
        groupBitOr(toUInt8(multiIf(
            status = 'pending', 1,
            status = 'finished', 2,
            status IN ('automation disabled', 'failed', 'member changed status', 'member unsubscribed'), 4,
            8
        ))) AS status_flags
    FROM _mv_automation_run_steps FINAL
    WHERE site_uuid = {{ String(site_uuid, required=True) }}
        AND automation_run_id IN (SELECT id FROM selected_status_runs)
    GROUP BY automation_run_id

NODE classified_runs
SQL >
    SELECT runs.created_at, steps.status_flags
    FROM selected_status_runs AS runs
    INNER JOIN run_status_flags AS steps ON steps.automation_run_id = runs.id

NODE entry_bounds
SQL >
    %
    -- Clock override keeps calendar tests deterministic, like api_kpis.
    WITH
        {% if defined(current_time) %}
        toDate(parseDateTime64BestEffort({{ String(current_time) }}, 3, 'UTC'), {{ String(timezone, 'UTC') }})
        {% else %}
        toDate(now(), {{ String(timezone, 'UTC') }})
        {% end %} AS today
    SELECT
        count() AS recorded_runs,
        today AS current_date,
        {% if defined(date_from) %}
        toDate({{ String(date_from) }}) AS first_date,
        {% else %}
        coalesce(minOrNull(toDate(created_at, {{ String(timezone, 'UTC') }})), today) AS first_date,
        {% end %}
        {% if defined(date_to) %}
        subtractDays(toDate({{ String(date_to) }}), 1) AS last_date
        {% else %}
        greatest(coalesce(maxOrNull(toDate(created_at, {{ String(timezone, 'UTC') }})), today), today) AS last_date
        {% end %}
    FROM classified_runs

NODE bucket_bounds
SQL >
    %
    SELECT *,
        first_date = last_date AS hourly,
        toDateTime(first_date, {{ String(timezone, 'UTC') }}) AS start_time,
        if(last_date > current_date, toDateTime(addDays(last_date, 1), {{ String(timezone, 'UTC') }}),
        least(toDateTime(addDays(last_date, 1), {{ String(timezone, 'UTC') }}),
            addHours(toStartOfHour(
                {% if defined(current_time) %}
                parseDateTime64BestEffort({{ String(current_time) }}, 3, 'UTC')
                {% else %}
                now()
                {% end %}, {{ String(timezone, 'UTC') }}), 1))) AS end_time
    FROM entry_bounds

NODE calendar
SQL >
    %
    SELECT arrayJoin(if(hourly,
        arrayMap(t -> formatDateTime(toDateTime(t), '%Y-%m-%dT%H:%i:%SZ', 'UTC'),
            range(toUInt32(start_time), toUInt32(end_time), 3600)),
        arrayMap(d -> toString(addDays(first_date, d)),
            range(toUInt32(dateDiff('day', first_date, last_date) + 1)))
    )) AS date
    FROM bucket_bounds

NODE performance_counts
SQL >
    %
    SELECT
        if((SELECT hourly FROM bucket_bounds),
            formatDateTime(toStartOfHour(created_at, {{ String(timezone, 'UTC') }}), '%Y-%m-%dT%H:%i:%SZ', 'UTC'),
            toString(toDate(created_at, {{ String(timezone, 'UTC') }}))) AS date,
        -- Unknown statuses are reported to Core as an error, even alongside pending steps.
        countIf(bitAnd(status_flags, 8) = 0 AND bitAnd(status_flags, 1) != 0) AS in_progress_run_count,
        countIf(status_flags = 2) AS completed_run_count,
        countIf(status_flags IN (4, 6)) AS exited_early_run_count,
        countIf(bitAnd(status_flags, 8) != 0) AS invalid_run_count
    FROM classified_runs
    GROUP BY date
    ORDER BY date ASC

NODE filled_performance_counts
SQL >
    SELECT
        calendar.date,
        coalesce(counts.in_progress_run_count, 0) AS in_progress_run_count,
        coalesce(counts.completed_run_count, 0) AS completed_run_count,
        coalesce(counts.exited_early_run_count, 0) AS exited_early_run_count,
        coalesce(counts.invalid_run_count, 0) AS invalid_run_count
    FROM calendar
    LEFT JOIN performance_counts AS counts ON calendar.date = counts.date
    ORDER BY calendar.date

TYPE ENDPOINT
