TOKEN "stats_page" READ

DESCRIPTION >
    The site's first recorded visit, so Admin's All time can start where the
    site's history does. Hits are sorted by site, then time, so this reads the
    start of the site's range only. Null when the site has no visits.

NODE first_visit
SQL >
    %
    select minOrNull(timestamp) as first_visit
    from _mv_hits
    where
        site_uuid = {{ String(site_uuid, 'mock_site_uuid', description="Site UUID", required=True) }}

TYPE ENDPOINT
