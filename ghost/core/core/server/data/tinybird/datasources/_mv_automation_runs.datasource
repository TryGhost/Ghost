SCHEMA >
    `site_uuid` UUID,
    `id` String,
    `automation_id` String,
    `created_at` DateTime64(3),
    `updated_at` DateTime64(3)

ENGINE ReplacingMergeTree
ENGINE_SORTING_KEY site_uuid, automation_id, id
ENGINE_VER updated_at

# Preserve existing versions when rebuilding with the new sorting key.
FORWARD_QUERY >
    SELECT *
