DESCRIPTION >
    Latest ten runs for one automation, with their current recorded status.

NODE selected_runs
SQL >
    %
    SELECT id, created_at
    FROM _mv_automation_runs FINAL
    WHERE site_uuid = {{ String(site_uuid, required=True) }}
        AND automation_id = {{ String(automation_id, required=True) }}
    ORDER BY created_at DESC, id DESC
    LIMIT 10

NODE run_status_flags
SQL >
    %
    SELECT
        automation_run_id,
        -- Same categories as api_automation_status_stats, limited to the selected runs.
        groupBitOr(toUInt8(multiIf(
            status = 'pending', 1,
            status = 'finished', 2,
            status IN ('automation disabled', 'failed', 'member changed status', 'member unsubscribed'), 4,
            8
        ))) AS status_flags,
        max(status = 'failed') AS has_failed_step
    FROM _mv_automation_run_steps FINAL
    WHERE site_uuid = {{ String(site_uuid, required=True) }}
        AND automation_run_id IN (SELECT id FROM selected_runs)
    GROUP BY automation_run_id

NODE runs_with_status
SQL >
    SELECT
        runs.id AS id,
        formatDateTime(runs.created_at, '%Y-%m-%dT%H:%i:%S.%fZ', 'UTC') AS created_at,
        multiIf(
            bitAnd(flags.status_flags, 1) != 0, 'in_progress',
            flags.status_flags = 2, 'completed',
            flags.status_flags IN (4, 6), 'exited_early',
            'unclassified'
        ) AS status,
        toBool(status = 'exited_early' AND flags.has_failed_step) AS failed
    FROM selected_runs AS runs
    LEFT JOIN run_status_flags AS flags ON flags.automation_run_id = runs.id
    ORDER BY runs.created_at DESC, runs.id DESC

TYPE ENDPOINT
