TOKEN "stats_page" READ

NODE automation_stats
SQL >
%
    with pending_runs as (
        select automation_run_id
        from automation_run_steps final
        where
            site_uuid = {{String(site_uuid, 'mock_site_uuid', description="Site UUID", required=True)}}
            and status = 'pending'
        group by automation_run_id
    )
    select
        runs.automation_id as automation_id,
        max(runs.created_at) as last_run_created_at,
        count() as total_run_count,
        countIf(notEmpty(pending_runs.automation_run_id)) as in_progress_run_count
    from automation_runs as runs final
    left join pending_runs on pending_runs.automation_run_id = runs.id
    where runs.site_uuid = {{String(site_uuid, 'mock_site_uuid', description="Site UUID", required=True)}}
    group by runs.automation_id
    order by runs.automation_id

TYPE ENDPOINT
