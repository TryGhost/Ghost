DESCRIPTION >
    Aggregate one complete member-search ID set or one bounded count window.

NODE selected_status_runs
SQL >
    %
    {% if len(String(run_ids, required=True)) > 749999 or len(String(run_ids, required=True).split(',')) > 30000 %}
        {{ error('run_ids exceeds the count batch limit') }}
    {% end %}
    SELECT id, created_at
    FROM _mv_automation_runs FINAL
    WHERE site_uuid = {{ String(site_uuid, required=True) }}
        AND automation_id = {{ String(automation_id, required=True) }}
        {% if defined(date_from) %}
        AND created_at >= toDateTime64({{ String(date_from) }}, 3, {{ String(timezone, 'UTC') }})
        {% end %}
        {% if defined(date_to) %}
        AND created_at < toDateTime64({{ String(date_to) }}, 3, {{ String(timezone, 'UTC') }})
        {% end %}
        AND id IN splitByChar(',', {{ String(run_ids, required=True) }})

NODE run_status_flags
SQL >
    %
    SELECT
        automation_run_id,
        -- Combine categories after FINAL has selected each step's latest version.
        groupBitOr(toUInt8(multiIf(
            status = 'pending', 1,
            status = 'finished', 2,
            status IN ('automation disabled', 'failed', 'member changed status', 'member unsubscribed'), 4,
            8
        ))) AS status_flags
    FROM _mv_automation_run_steps FINAL
    WHERE site_uuid = {{ String(site_uuid, required=True) }}
        AND automation_run_id >= {{ String(first_id, required=True) }}
        AND automation_run_id <= {{ String(last_id, required=True) }}
    GROUP BY automation_run_id

NODE automation_status_buckets
SQL >
    %
    SELECT
        if({{ Boolean(hourly, False) }},
            formatDateTime(toStartOfHour(runs.created_at, {{ String(timezone, 'UTC') }}), '%Y-%m-%dT%H:%i:%SZ', 'UTC'),
            toString(toDate(runs.created_at, {{ String(timezone, 'UTC') }}))) AS date,
        countIf(bitAnd(status_flags, 8) = 0 AND bitAnd(status_flags, 1) != 0) AS in_progress_run_count,
        countIf(status_flags = 2) AS completed_run_count,
        countIf(status_flags IN (4, 6)) AS exited_early_run_count,
        countIf(bitAnd(status_flags, 8) != 0) AS invalid_run_count
    FROM selected_status_runs runs
    INNER JOIN run_status_flags flags ON flags.automation_run_id = runs.id

    GROUP BY date

NODE automation_status_counts
SQL >
    %
    SELECT
        sum(b.in_progress_run_count) AS in_progress_run_count,
        sum(b.completed_run_count) AS completed_run_count,
        sum(b.exited_early_run_count) AS exited_early_run_count,
        sum(b.invalid_run_count) AS invalid_run_count
        , arraySort(groupArray((date, b.in_progress_run_count + b.completed_run_count + b.exited_early_run_count))) AS entries
    FROM automation_status_buckets b
    SETTINGS max_execution_time = 2

TYPE ENDPOINT
