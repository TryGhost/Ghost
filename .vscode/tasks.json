{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ghost: Dev stack",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "dev" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
