{
  "name": "@tryghost/test-data",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Ghost Foundation",
  "repository": "https://github.com/TryGhost/Ghost/tree/main/testing/test-data",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./selectors/*": "./src/selectors/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "pnpm test:types && pnpm test:unit",
    "test:unit": "vitest run",
    "test:types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ test/ --cache"
  },
  "dependencies": {
    "@faker-js/faker": "catalog:"
  },
  "devDependencies": {
    "@internal/cfg-eslint": "workspace:*",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "ghostPackage": {
    "goldenPath": "exempt",
    "reason": "Test-only source package consumed directly as TypeScript without a production build artifact."
  }
}
