{
  "name": "@tryghost/theme-renderer",
  "version": "0.0.0",
  "description": "Ghost's theme rendering pipeline as an Express-free, web-standard package",
  "private": true,
  "ghostPackage": {
    "goldenPath": "compliant"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryGhost/Ghost.git",
    "directory": "packages/theme-renderer"
  },
  "author": "Ghost Foundation",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./markers": {
      "source": "./src/engine/markers.ts",
      "types": "./build/engine/markers.d.ts",
      "default": "./build/engine/markers.js"
    },
    "./editor": {
      "source": "./src/editor/text-edit.ts",
      "types": "./build/editor/text-edit.d.ts",
      "default": "./build/editor/text-edit.js"
    },
    "./editor/archive": {
      "source": "./src/editor/archive.ts",
      "types": "./build/editor/archive.d.ts",
      "default": "./build/editor/archive.js"
    },
    "./editor/instance-config": {
      "source": "./src/editor/instance-config.ts",
      "types": "./build/editor/instance-config.d.ts",
      "default": "./build/editor/instance-config.js"
    }
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test:unit": "NODE_ENV=testing vitest run --coverage",
    "test:types": "tsc --noEmit -p test/tsconfig.json",
    "test:types:browser": "tsc --noEmit -p test/browser/tsconfig.src.json && tsc --noEmit -p test/browser/tsconfig.json",
    "test": "pnpm run '/^test:/'",
    "browser:test": "vitest run --config vitest.browser.config.ts",
    "lint:code": "eslint src/ --cache",
    "lint:test": "eslint test/ --cache",
    "lint": "pnpm run '/^lint:/'"
  },
  "files": [
    "build"
  ],
  "devDependencies": {
    "@internal/cfg-eslint": "workspace:*",
    "@internal/cfg-typescript": "workspace:*",
    "@internal/cfg-vitest": "workspace:*",
    "@types/common-tags": "catalog:",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@types/sanitize-html": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@tryghost/custom-fonts": "catalog:",
    "@tryghost/errors": "catalog:",
    "@tryghost/helpers": "catalog:",
    "@tryghost/nql-lang": "catalog:",
    "@tryghost/social-urls": "catalog:",
    "@tryghost/string": "catalog:",
    "@tryghost/tpl": "catalog:",
    "common-tags": "catalog:",
    "downsize-cjs": "catalog:",
    "handlebars": "catalog:",
    "human-number": "catalog:",
    "jszip": "catalog:",
    "lodash": "catalog:",
    "moment-timezone": "catalog:",
    "path-to-regexp": "catalog:",
    "sanitize-html": "catalog:"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/build"
        ]
      }
    }
  }
}
