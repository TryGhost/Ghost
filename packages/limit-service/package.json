{
    "name": "@tryghost/limit-service",
    "version": "0.0.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TryGhost/Ghost.git",
        "directory": "packages/limit-service"
    },
    "author": "Ghost Foundation",
    "license": "MIT",
    "main": "build/index.js",
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "types": "./build/index.d.ts",
            "default": "./build/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch --preserveWatchOutput",
        "test:unit": "NODE_ENV=testing vitest run --coverage",
        "test:types": "tsc --noEmit -p test/tsconfig.json",
        "test": "pnpm run '/^test:/'",
        "lint:code": "eslint src/ --cache",
        "lint:test": "eslint test/ --cache",
        "lint": "pnpm run '/^lint:/'"
    },
    "files": [
        "build"
    ],
    "devDependencies": {
        "@internal/cfg-eslint": "workspace:*",
        "@internal/cfg-typescript": "workspace:*",
        "@internal/cfg-vitest": "workspace:*",
        "@types/lodash": "catalog:",
        "@types/luxon": "catalog:",
        "@types/node": "catalog:",
        "@typescript/native": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "eslint": "catalog:",
        "knex": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@tryghost/errors": "catalog:",
        "lodash": "catalog:",
        "luxon": "catalog:"
    },
    "private": true,
    "ghostPackage": {
        "goldenPath": "compliant"
    },
    "type": "module",
    "types": "build/index.d.ts",
    "nx": {
        "targets": {
            "build": {
                "outputs": [
                    "{projectRoot}/build"
                ]
            }
        }
    }
}
