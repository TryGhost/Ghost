# E2E test layer: copies locally-built public apps into Ghost's built admin
# assets so Ghost serves them from /ghost/assets/* (same origin, no CORS).
#
# This mirrors the /ghost/assets/<app>/ paths used in dev mode. Don't serve
# them from /content/files/ — uploaded files there are deliberately served as
# inert types (text/plain + nosniff), so browsers won't execute the scripts.
#
# Usage:
#   docker build -f e2e/Dockerfile.e2e \
#     --build-arg GHOST_IMAGE=ghost-monorepo:latest \
#     -t ghost-e2e:local .
#
# Intended for the production Ghost image built in CI (the `full` target, which
# includes the admin build).

ARG GHOST_IMAGE=ghost-monorepo:latest
FROM $GHOST_IMAGE

# Public app UMD bundles — Ghost serves core/built/admin/assets at /ghost/assets/
COPY apps/portal/umd /home/ghost/core/built/admin/assets/portal
COPY apps/comments-ui/umd /home/ghost/core/built/admin/assets/comments-ui
COPY apps/sodo-search/umd /home/ghost/core/built/admin/assets/sodo-search
COPY apps/signup-form/umd /home/ghost/core/built/admin/assets/signup-form
COPY apps/announcement-bar/umd /home/ghost/core/built/admin/assets/announcement-bar

ENV portal__url=/ghost/assets/portal/portal.min.js
ENV comments__url=/ghost/assets/comments-ui/comments-ui.min.js
ENV sodoSearch__url=/ghost/assets/sodo-search/sodo-search.min.js
ENV sodoSearch__styles=/ghost/assets/sodo-search/main.css
ENV signupForm__url=/ghost/assets/signup-form/signup-form.min.js
ENV announcementBar__url=/ghost/assets/announcement-bar/announcement-bar.min.js
