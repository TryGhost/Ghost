{
  "name": "@internal/cfg-oxlint",
  "version": "private",
  "private": true,
  "description": "Ghost custom Oxlint rules",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test:types": "tsc6 --noEmit"
  },
  "dependencies": {
    "js-yaml": "catalog:"
  },
  "devDependencies": {
    "@internal/cfg-typescript": "workspace:*",
    "@oxlint/plugins": "catalog:",
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "nx": {
    "targets": {
      "test:types": {
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/.dependency-cruiser.cjs",
          "{workspaceRoot}/tools/scripts/ci/service-dependency-resolver.mjs"
        ]
      }
    }
  }
}
