{
  "name": "@internal/gx",
  "version": "private",
  "private": true,
  "description": "Ghost contributor CLI",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "eslint . --cache",
    "test:unit": "node --test test/*.test.ts",
    "test": "pnpm run '/^test:/'",
    "test:types": "tsc6 --noEmit"
  },
  "dependencies": {
    "@internal/scripts": "workspace:*",
    "@tryghost/errors": "catalog:",
    "@tryghost/logging": "catalog:",
    "@tryghost/pretty-cli": "catalog:",
    "bson-objectid": "catalog:",
    "chalk": "catalog:",
    "cli-progress": "catalog:",
    "dependency-cruiser": "catalog:",
    "inquirer": "catalog:",
    "js-yaml": "catalog:",
    "jsonwebtoken": "catalog:",
    "knex": "catalog:",
    "knex-migrator": "catalog:",
    "luxon": "catalog:",
    "semver": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@internal/cfg-eslint": "workspace:*",
    "@internal/cfg-typescript": "workspace:*",
    "@types/js-yaml": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "nx": {
    "namedInputs": {
      "packageTemplate": [
        "{workspaceRoot}/packages/_template/**/*"
      ],
      "goldenEmailCommand": [
        "{workspaceRoot}/ghost/test/utils/fixtures/email-service/golden-post.json"
      ],
      "developmentTablesCommand": [
        "{workspaceRoot}/ghost/core/server/data/schema/in-development.ts",
        "{workspaceRoot}/ghost/core/server/data/schema/schema.js",
        "{workspaceRoot}/ghost/tsconfig.json",
        "{workspaceRoot}/ghost/types/**/*.d.ts"
      ],
      "dataCommands": [
        "{workspaceRoot}/ghost/bin/generate-data.ts",
        "{workspaceRoot}/ghost/core/server/data/seeders/**/*",
        "{workspaceRoot}/ghost/core/server/data/schema/**/*",
        "{workspaceRoot}/ghost/core/server/models/**/*"
      ],
      "developmentStackCommands": [
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/.codex/hooks.json"
      ],
      "serviceReports": [
        "{workspaceRoot}/.dependency-cruiser.cjs",
        "{workspaceRoot}/tools/scripts/ci/service-dependency-resolver.mjs"
      ]
    },
    "targets": {
      "test:unit": {
        "inputs": [
          "default",
          "^default",
          "packageTemplate",
          "developmentTablesCommand",
          "goldenEmailCommand",
          "dataCommands",
          "developmentStackCommands",
          "serviceReports",
          {
            "runtime": "node -v"
          }
        ]
      },
      "test:types": {
        "inputs": [
          "default",
          "^default",
          "developmentTablesCommand",
          "dataCommands",
          {
            "runtime": "node -v"
          }
        ]
      }
    }
  }
}
