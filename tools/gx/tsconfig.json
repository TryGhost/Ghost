{
  "extends": "@internal/cfg-typescript/esm.json",
  "compilerOptions": {
    "noEmit": true,
    // Core's development-table helper uses Array.prototype.toReversed.
    "lib": ["es2023"],
    "erasableSyntaxOnly": true,
    // Match runtime: gx runs core with --conditions=source, so workspace deps needn't be built.
    "customConditions": ["source"]
  },
  "include": ["*.ts", "lib/**/*.ts", "test/**/*.ts"]
}
