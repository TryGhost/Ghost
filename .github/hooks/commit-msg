#!/usr/bin/env sh
# Run the committing checkout's script. A worktree's core.hooksPath can point
# into another checkout, whose scripts may be from a different branch.
script="$(git rev-parse --show-toplevel)/.github/hooks/commit-msg.bash"
[ -f "$script" ] || script="$(dirname "$0")/commit-msg.bash"
exec bash "$script" "$@"
