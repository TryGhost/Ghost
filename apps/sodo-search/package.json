{
  "name": "@tryghost/sodo-search",
  "version": "1.8.31",
  "description": "Search interface for Ghost sites",
  "license": "MIT",
  "author": "Ghost Foundation",
  "repository": "https://github.com/TryGhost/Ghost",
  "files": [
    "umd/",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint src test --cache",
    "preship": "pnpm lint",
    "ship": "node ../../scripts/release-apps.js",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@tryghost/debug": "catalog:",
    "@tryghost/i18n": "workspace:*",
    "flexsearch": "0.8.212",
    "react": "catalog:react17",
    "react-dom": "catalog:react17"
  },
  "devDependencies": {
    "@internal/cfg-eslint-react": "workspace:*",
    "@internal/cfg-vite-public-app": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:react17",
    "@vitest/coverage-v8": "catalog:",
    "autoprefixer": "10.5.4",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "nock": "catalog:",
    "postcss": "catalog:",
    "postcss-import": "16.1.1",
    "tailwindcss": "catalog:tailwind3",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "coverageReporters": [
      "cobertura",
      "text-summary",
      "html"
    ]
  },
  "nx": {
    "targets": {
      "dev": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/sodo-search",
          "command": "vite build --watch --mode development"
        }
      }
    },
    "tags": [
      "i18n",
      "public-app"
    ]
  }
}
