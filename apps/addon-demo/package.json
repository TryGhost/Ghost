{
  "name": "@tryghost/addon-demo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Ghost Foundation",
  "repository": {
    "type": "git",
    "url": "https://github.com/TryGhost/Ghost/tree/main/apps/addon-demo"
  },
  "type": "module",
  "scripts": {
    "dev": "node build.mjs && node server.mjs",
    "build": "tsc && node build.mjs",
    "serve": "node server.mjs",
    "lint": "eslint --cache src",
    "lint:fix": "eslint --cache --fix src"
  },
  "dependencies": {
    "@tryghost/addon-kit": "workspace:*",
    "preact": "catalog:"
  },
  "devDependencies": {
    "@internal/cfg-eslint-react": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "nx": {
    "targets": {
      "dev": {
        "continuous": true,
        "dependsOn": [
          "^build"
        ]
      },
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ],
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
