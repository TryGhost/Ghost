{
  "name": "@tryghost/admin-toolbar",
  "version": "0.1.11",
  "description": "Frontend staff toolbar for Ghost sites",
  "license": "MIT",
  "author": "Ghost Foundation",
  "repository": "https://github.com/TryGhost/Ghost",
  "files": [
    "umd/",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.editor.config.mjs && vite build --config vite.worker.config.mjs",
    "build:editor": "vite build --config vite.editor.config.mjs",
    "build:worker": "vite build --config vite.worker.config.mjs",
    "dev": "concurrently -n main,editor,worker \"pnpm dev:main\" \"pnpm dev:editor\" \"pnpm dev:worker\"",
    "dev:main": "vite build --watch --mode development",
    "dev:editor": "vite build --watch --mode development --config vite.editor.config.mjs",
    "dev:worker": "vite build --watch --mode development --config vite.worker.config.mjs",
    "lint": "eslint src test --cache",
    "test": "pnpm test:unit",
    "test:unit": "pnpm run build && vitest run",
    "preship": "pnpm lint",
    "ship": "node ../../scripts/release-apps.js",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@tryghost/theme-renderer": "workspace:*",
    "preact": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@internal/cfg-eslint": "workspace:*",
    "@internal/cfg-vite-public-app": "workspace:*",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-ghost": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "targets": {
      "dev": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/admin-toolbar",
          "command": "pnpm dev"
        }
      }
    },
    "tags": [
      "public-app"
    ]
  }
}
