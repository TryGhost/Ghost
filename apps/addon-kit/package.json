{
  "name": "@tryghost/addon-kit",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Ghost Foundation",
  "repository": {
    "type": "git",
    "url": "https://github.com/TryGhost/Ghost/tree/main/apps/addon-kit"
  },
  "type": "module",
  "exports": {
    "./host": "./src/host/index.ts",
    "./editor-host": {
      "types": "./src/host/editor-entry.ts",
      "default": "./dist/editor-host.mjs"
    },
    "./addon": "./src/addon/index.ts",
    "./editor": "./src/editor/index.ts",
    "./editor-settings": "./src/editor-settings/index.ts",
    "./bootstrap": {
      "types": "./dist/bootstrap.d.mts",
      "default": "./dist/bootstrap.mjs"
    }
  },
  "scripts": {
    "dev": "concurrently \"vite build --watch\" \"vite build --watch --config vite.editor-host.config.mts\"",
    "build": "vite build && vite build --config vite.editor-host.config.mts && tsc",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --cache src test",
    "lint:fix": "eslint --cache --fix src test",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@quilted/threads": "catalog:",
    "@remote-dom/core": "catalog:",
    "@remote-dom/preact": "catalog:",
    "@remote-dom/react": "catalog:",
    "@tryghost/admin-x-framework": "workspace:*",
    "@tryghost/shade": "workspace:*",
    "preact": "catalog:",
    "preact-render-to-string": "catalog:",
    "react": "catalog:",
    "sonner": "catalog:"
  },
  "devDependencies": {
    "@internal/cfg-eslint-react": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "targets": {
      "dev": {
        "continuous": true,
        "dependsOn": [
          "^build"
        ]
      },
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ],
        "dependsOn": [
          "^build"
        ]
      },
      "test:unit": {
        "dependsOn": [
          "build"
        ]
      },
      "test": {
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
