{
  "name": "@tryghost/admin-x-framework",
  "version": "0.0.0",
  "private": true,
  "author": "Ghost Foundation",
  "repository": "https://github.com/TryGhost/Ghost/tree/main/apps/admin-x-framework",
  "files": [
    "dist",
    "types"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./errors": {
      "types": "./types/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./helpers": {
      "types": "./types/helpers.d.ts",
      "import": "./dist/helpers.js",
      "require": "./dist/helpers.cjs"
    },
    "./hooks": {
      "types": "./types/hooks.d.ts",
      "import": "./dist/hooks.js",
      "require": "./dist/hooks.cjs"
    },
    "./api/*": {
      "types": "./types/api/*.d.ts",
      "import": "./dist/api/*.js",
      "require": "./dist/api/*.cjs"
    },
    "./utils/post-utils": {
      "types": "./types/utils/post-utils.d.ts",
      "import": "./dist/utils/post-utils.js",
      "require": "./dist/utils/post-utils.cjs"
    },
    "./utils/get-site-timezone": {
      "types": "./types/utils/get-site-timezone.d.ts",
      "import": "./dist/utils/get-site-timezone.js",
      "require": "./dist/utils/get-site-timezone.cjs"
    },
    "./vite": {
      "types": "./types/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./playwright": {
      "types": "./types/playwright.d.ts",
      "import": "./dist/playwright.js",
      "require": "./dist/playwright.cjs"
    },
    "./test/*": {
      "types": "./types/test/*.d.ts",
      "import": "./dist/test/*.js",
      "require": "./dist/test/*.cjs"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -p tsconfig.declaration.json && vite build",
    "test": "pnpm run '/^test:/'",
    "test:types": "tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "lint:code": "eslint src/ --cache",
    "lint": "pnpm run '/^lint:/'",
    "lint:test": "eslint test/ --cache"
  },
  "dependencies": {
    "@sentry/react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tinybirdco/charts": "0.3.0",
    "@tryghost/custom-field-types": "workspace:*",
    "@tryghost/nql-string": "workspace:*",
    "@tryghost/shade": "workspace:*",
    "bson-objectid": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "sonner": "catalog:"
  },
  "devDependencies": {
    "@internal/cfg-eslint-react": "workspace:*",
    "@playwright/test": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@tryghost/koenig-lexical": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "glob": "catalog:",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-css-injected-by-js": "3.5.2",
    "vite-plugin-svgr": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "nx": {
    "targets": {
      "dev": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/admin-x-framework",
          "command": "vite build --watch"
        },
        "dependsOn": [
          "build"
        ]
      },
      "build": {
        "dependsOn": [
          "^build"
        ]
      },
      "test:unit": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
