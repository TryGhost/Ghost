<div class="modal-content gh-paid-post-preview-warning" data-test-modal="paid-post-preview-warning">
    <header class="modal-header">
        <h1>Send the full post to all selected email recipients?</h1>
    </header>
    <button type="button" class="close" title="Close" {{on "click" (fn @close "stay")}}>{{svg-jar "close"}}<span class="hidden">Close</span></button>

    <div class="modal-body">
        {{#if (eq @data.visibility "tiers")}}
            <p>
                Your post is for the {{@data.tierNames}}
                {{if (gt @data.tierCount 1) "tiers" "tier"}}, but you’re about to email it in full to
                {{format-number @data.noAccessCount}}
                {{gh-pluralize @data.noAccessCount "subscriber" without-count=true}}
                outside {{if (gt @data.tierCount 1) "those tiers" "that tier"}}{{unless @data.allLackAccess " too"}}. To send them a
                teaser instead, add a
                <a href="https://ghost.org/help/public-previews/" target="_blank" rel="noopener noreferrer" data-test-link="public-preview-help">public preview</a>
                to your post.
            </p>
        {{else}}
            <p>
                Your post is for paid subscribers, but you’re about to email it in full to
                {{format-number @data.noAccessCount}} free
                {{gh-pluralize @data.noAccessCount "subscriber" without-count=true}}{{unless @data.allLackAccess " too"}}. To send them a
                teaser instead, add a
                <a href="https://ghost.org/help/public-previews/" target="_blank" rel="noopener noreferrer" data-test-link="public-preview-help">public preview</a>
                to your post.
            </p>
        {{/if}}
    </div>

    <div class="modal-footer">
        <button type="button" class="gh-btn" {{on "click" (fn @close "continue")}} data-test-button="continue-without-preview"><span>Continue with full post</span></button>
        <button type="button" class="gh-btn gh-btn-black" {{on "click" (fn @close "editor")}} data-test-button="add-public-preview"><span>Add public preview</span></button>
    </div>
</div>
