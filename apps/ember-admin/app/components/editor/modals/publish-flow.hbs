<div class="flex flex-column h-100 items-center overflow-auto" data-test-modal="publish-flow">
    <header class="gh-publish-header">
        <h2>Publish</h2>

        {{#unless this.isComplete}}
            <div class="gh-btn-group-right">
                <button
                    type="button"
                    class="gh-btn gh-btn-editor gh-editor-preview-trigger"
                    title="Close"
                    {{on "click" @close}}
                    data-test-button="publish-flow-publish"
                >
                    <span>Close</span>
                </button>
                {{! the redesign has no Preview button: every step shows the
                    thing it is asking about, and the evidence links are in
                    the steps themselves }}
                {{#unless (or this.emailErrorMessage this.useRedesign)}}
                    <button
                        type="button"
                        class="gh-btn"
                        {{on "click" @data.togglePreviewPublish}}
                        data-test-button="publish-flow-preview"
                    >
                        <span>Preview</span>
                    </button>
                {{/unless}}
            </div>
        {{/unless}}
    </header>

    <div class="gh-publish-settings-container {{if this.useRedesign "gh-publish-redesign"}} {{unless @data.skipAnimation "fade-in"}}">
        {{#if this.emailErrorMessage}}
            <Editor::Modals::PublishFlow::CompleteWithEmailError
                @emailErrorMessage={{this.emailErrorMessage}}
                @publishOptions={{@data.publishOptions}}
                @setCompleted={{this.setCompleted}}
                @close={{@close}}
            />
        {{else if this.useRedesign}}
            {{#if (eq this.step "website")}}
                <Editor::Modals::PublishFlow::Website
                    @publishOptions={{@data.publishOptions}}
                    @editorAPI={{@data.editorAPI}}
                    @savePostTask={{@data.savePostTask}}
                    @tiers={{@data.tiers}}
                    @setDocked={{this.setDocked}}
                    @autoPlacement={{this.placementReturnStep}}
                    @onPlacementDone={{this.finishPlacement}}
                    @next={{fn this.setStep "email"}}
                    @close={{@close}}
                />
            {{else if (eq this.step "email")}}
                <Editor::Modals::PublishFlow::Email
                    @publishOptions={{@data.publishOptions}}
                    @editorAPI={{@data.editorAPI}}
                    @savePostTask={{@data.savePostTask}}
                    @startPlacement={{fn this.startPlacement "email"}}
                    @back={{fn this.setStep "website"}}
                    @next={{fn this.setStep "timing"}}
                    @close={{@close}}
                />
            {{else if (eq this.step "timing")}}
                <Editor::Modals::PublishFlow::Timing
                    @publishOptions={{@data.publishOptions}}
                    @back={{fn this.setStep "email"}}
                    @next={{fn this.setStep "confirm"}}
                    @close={{@close}}
                />
            {{else}}
                <Editor::Modals::PublishFlow::Confirm
                    @publishOptions={{@data.publishOptions}}
                    @recipientType={{this.recipientType}}
                    @summary={{@data.publishOptions.whoGetsWhatSummary}}
                    @saveTask={{this.saveTask}}
                    @setCompleted={{this.setCompleted}}
                    @cancel={{fn this.setStep "timing"}}
                    @close={{@close}}
                />
            {{/if}}
        {{else if this.isConfirming}}
            <Editor::Modals::PublishFlow::Confirm
                @publishOptions={{@data.publishOptions}}
                @recipientType={{this.recipientType}}
                @saveTask={{this.saveTask}}
                @setCompleted={{this.setCompleted}}
                @cancel={{this.toggleConfirm}}
                @close={{@close}}
            />
        {{else}}
            <Editor::Modals::PublishFlow::Options
                @publishOptions={{@data.publishOptions}}
                @recipientType={{this.recipientType}}
                @confirm={{this.toggleConfirm}}
                @close={{@close}}
            />
        {{/if}}
    </div>
</div>
