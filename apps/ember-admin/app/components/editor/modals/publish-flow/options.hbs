<div class="gh-publish-title" data-test-publish-flow="options">
    <div class="green">Ready, set, publish.</div>
    <div>Share it with the world.</div>
</div>

{{#if @publishOptions.publishDisabledError}}
    <p class="gh-box gh-content-box pa" data-test-publish-type-error="publish-disabled">
        {{@publishOptions.publishDisabledError}}
    </p>
{{else}}
    <div class="gh-pubflow">

        <div class="gh-pubflow-row {{unless this.webChecked "gh-pubflow-row-off"}}" data-test-setting="publish-web">
            <div class="gh-pubflow-row-head">
                {{svg-jar "globe-simple"}}
                <span class="gh-pubflow-row-label">
                    {{if this.webChecked "Publish on the site" "Not published on the site"}}
                </span>
                <div class="for-switch small">
                    <label class="switch">
                        <input type="checkbox" checked={{this.webChecked}} {{on "change" this.toggleWeb}} data-test-checkbox="publish-web">
                        <span class="input-toggle-component"></span>
                    </label>
                </div>
            </div>
            {{#if (and this.webChecked this.webLine)}}
                <p class="gh-pubflow-outcome" data-testid="web-outcome">{{this.webLine}}</p>
            {{/if}}
        </div>

        {{#unless @publishOptions.emailUnavailable}}
            <div class="gh-pubflow-row {{unless this.emailActive "gh-pubflow-row-off"}}" data-test-setting="publish-email">
                <div class="gh-pubflow-row-head">
                    {{svg-jar "send-email"}}
                    {{#if this.emailActive}}
                        <span class="gh-pubflow-row-label gh-pubflow-row-label-email gh-pubflow-when-label">
                            Email
                            <button type="button" class="gh-pubflow-inline-trigger" {{on "click" this.toggleAudienceMenu}} data-testid="email-audience-trigger">
                                {{#let (members-count-fetcher query=(hash filter=this.totalCountFilter)) as |totalFetcher|}}
                                    {{if (eq this.audienceChoice "all") "all "}}<span class="gh-pubflow-count">{{if totalFetcher.isLoading "…" (format-number totalFetcher.count)}}</span> subscribers
                                {{/let}}
                                {{svg-jar "arrow-down-small" class="gh-pubflow-caret"}}
                            </button>
                            {{#if (eq this.openMenu "audience")}}
                                <div class="gh-pubflow-when-menu" data-testid="audience-menu">
                                    <button type="button" class="{{if (eq this.audienceChoice "all") "active"}}" {{on "click" this.chooseAllAudience}} data-testid="audience-option-all">
                                        All subscribers
                                        {{#if (eq this.audienceChoice "all")}}{{svg-jar "check-2"}}{{/if}}
                                    </button>
                                    {{#if this.accessAudienceFilter}}
                                        <button type="button" class="{{if (eq this.audienceChoice "access") "active"}}" {{on "click" this.chooseAccessAudience}} data-testid="audience-option-access">
                                            Only people with full post access
                                            {{#if (eq this.audienceChoice "access")}}{{svg-jar "check-2"}}{{/if}}
                                        </button>
                                    {{/if}}
                                    <button type="button" class="{{if (eq this.audienceChoice "specific") "active"}}" {{on "click" this.chooseSpecificAudience}} data-testid="audience-option-specific">
                                        Specific people&hellip;
                                        {{#if (eq this.audienceChoice "specific")}}{{svg-jar "check-2"}}{{/if}}
                                    </button>
                                </div>
                            {{/if}}
                            {{#if (gt @publishOptions.newsletters.length 1)}}
                                of
                                <span class="gh-pubflow-when-label" data-test-select="newsletter">
                                    <button type="button" class="gh-pubflow-inline-trigger" {{on "click" this.toggleNewsletterMenu}} data-testid="newsletter-trigger">
                                        {{@publishOptions.newsletter.name}}
                                        {{svg-jar "arrow-down-small" class="gh-pubflow-caret"}}
                                    </button>
                                    {{#if (eq this.openMenu "newsletter")}}
                                        <div class="gh-pubflow-when-menu" data-testid="newsletter-menu">
                                            {{#each @publishOptions.newsletters as |newsletter|}}
                                                <button type="button" class="{{if (eq newsletter @publishOptions.newsletter) "active"}}" {{on "click" (fn this.chooseNewsletter newsletter)}} data-test-select-option={{newsletter.name}}>
                                                    {{newsletter.name}}
                                                    {{#if (eq newsletter @publishOptions.newsletter)}}{{svg-jar "check-2"}}{{/if}}
                                                </button>
                                            {{/each}}
                                        </div>
                                    {{/if}}
                                </span>
                            {{/if}}
                        </span>
                    {{else}}
                        <span class="gh-pubflow-row-label">Not sent as newsletter</span>
                    {{/if}}
                    <div class="for-switch small">
                        <label class="switch">
                            <input type="checkbox" checked={{this.emailChecked}} disabled={{@publishOptions.emailDisabled}} {{on "change" this.toggleEmail}} data-test-checkbox="publish-email">
                            <span class="input-toggle-component"></span>
                        </label>
                    </div>
                </div>
                {{#if this.emailActive}}
                    {{#if this.showAudiencePicker}}
                        <div class="gh-pubflow-segments" data-test-select="segment-groups">
                            <GhSegmentTokenInput
                                @nonLabelOptions={{this.nonLabelOptions}}
                                @selectedSegments={{this.selectedSegments}}
                                @onChange={{this.selectSegments}}
                                @renderInPlace={{false}}
                                @class="select-members select-members-recipient"
                                @dropdownClass="gh-publish-newsletter-dropdown"
                                @searchMessage="All groups selected"
                            />
                        </div>
                    {{/if}}
                    {{#if this.hasSplit}}
                        <p class="gh-pubflow-outcome" data-testid="email-outcome">
                            {{#let (members-count-fetcher query=(hash filter=this.fullCountFilter)) as |fullFetcher|}}
                                    <span class="gh-pubflow-count">{{if fullFetcher.isLoading "…" (format-number fullFetcher.count)}}</span> {{this.fullNoun}} get the full post
                                {{/let}}
                                {{#if this.otherCountFilter}}
                                    {{#let (members-count-fetcher query=(hash filter=this.otherCountFilter)) as |otherFetcher|}}
                                        {{#if (gt otherFetcher.count 0)}}
                                            {{#if this.fullyLocked}}
                                                &middot; <span class="gh-pubflow-count">{{format-number otherFetcher.count}}</span> {{this.notEmailedNoun}} <span class="gh-pubflow-when-label"><button type="button" class="gh-pubflow-inline-trigger" {{on "click" this.toggleLockedOutcomeMenu}} data-testid="locked-outcome-trigger">{{this.lockedOutcomeLabel}}{{svg-jar "arrow-down-small" class="gh-pubflow-caret"}}</button>
                                                {{#if (eq this.openMenu "locked-outcome")}}
                                                    <span class="gh-pubflow-when-menu" data-testid="locked-outcome-menu">
                                                        <button type="button" class="{{unless this.post.emailFullPost "active"}}" {{on "click" (fn this.chooseLockedOutcome false)}} data-testid="locked-outcome-teaser">
                                                            The title &amp; image only
                                                            {{#unless this.post.emailFullPost}}{{svg-jar "check-2"}}{{/unless}}
                                                        </button>
                                                        <button type="button" class="{{if this.post.emailFullPost "active"}}" {{on "click" (fn this.chooseLockedOutcome true)}} data-testid="locked-outcome-full">
                                                            The full post &mdash; bypasses the divider
                                                            {{#if this.post.emailFullPost}}{{svg-jar "check-2"}}{{/if}}
                                                        </button>
                                                    </span>
                                                {{/if}}
                                                </span>
                                            {{else}}
                                                &middot; <span class="gh-pubflow-count">{{format-number otherFetcher.count}}</span> {{this.otherOutcomeLabel}}
                                            {{/if}}
                                        {{else if (not otherFetcher.isLoading)}}
                                            &middot; {{this.notEmailedNote}}
                                        {{/if}}
                                    {{/let}}
                                {{/if}}
                        </p>
                    {{/if}}
                {{else if this.emailDisabledReason}}
                    <p class="gh-pubflow-outcome" data-testid="email-disabled-reason">{{this.emailDisabledReason}}</p>
                {{/if}}
            </div>
        {{/unless}}

        <div class="gh-pubflow-row" data-test-setting="publish-at">
            <div class="gh-pubflow-row-head">
                {{svg-jar "clock"}}
                <span class="gh-pubflow-row-label gh-pubflow-when-label">
                    <button type="button" class="gh-pubflow-inline-trigger" {{on "click" this.toggleWhenMenu}} data-testid="publish-at-trigger">
                        {{#if @publishOptions.isScheduled}}{{this.relativeScheduleLabel}}{{else}}Right now{{/if}}
                        {{svg-jar "arrow-down-small" class="gh-pubflow-caret"}}
                    </button>
                    {{#if (eq this.openMenu "when")}}
                        <div class="gh-pubflow-when-menu" data-testid="when-menu">
                            <button type="button" class="{{unless @publishOptions.isScheduled "active"}}" {{on "click" this.chooseNow}} data-testid="when-option-now">
                                Right now
                                {{#unless @publishOptions.isScheduled}}{{svg-jar "check-2"}}{{/unless}}
                            </button>
                            <button type="button" class="{{if @publishOptions.isScheduled "active"}}" {{on "click" this.chooseLater}} data-testid="when-option-later">
                                Schedule for later
                                {{#if @publishOptions.isScheduled}}{{svg-jar "check-2"}}{{/if}}
                            </button>
                        </div>
                    {{/if}}
                </span>
            </div>
            {{#if @publishOptions.isScheduled}}
                <div class="gh-pubflow-when-picker" data-test-setting="schedule-picker">
                    <GhDateTimePicker
                        @datePickerClass="publish-flow-datepicker"
                        @date={{moment-format (moment-site-tz @publishOptions.scheduledAtUTC) "YYYY-MM-DD"}}
                        @time={{moment-format (moment-site-tz @publishOptions.scheduledAtUTC) "HH:mm"}}
                        @setDate={{this.setDate}}
                        @setTime={{this.setTime}}
                        @minDate={{moment-site-tz @publishOptions.minScheduledAt}}
                        @isActive={{true}}
                        @renderInPlace={{false}}
                    />
                </div>
            {{/if}}
        </div>

    </div>

    {{#if @publishOptions.willEmail}}
        <Editor::EmailSizeWarning @post={{@publishOptions.post}} as |overLimit emailSizeKb| >
            {{#if overLimit}}
                <p class="gh-box gh-content-box pa gh-publish-setting-email-warning">
                    <div class="gh-email-preview-clip-title mb">This email is <span class="yellow-d1">{{emailSizeKb}}kB</span></div>
                    <div class="gh-email-preview-clip-description">Email newsletters may get clipped in the inbox behind a “View entire message” link when they’re over 100kB.</div>
                </p>
            {{/if}}
        </Editor::EmailSizeWarning>
    {{/if}}

    <div class="gh-publish-cta gh-pubflow-cta">
        <button type="button" class="gh-btn gh-btn-black gh-btn-large" {{on "click" @confirm}} data-test-button="continue">
            <span>Continue, final review &rarr;</span>
        </button>
    </div>
{{/if}}
