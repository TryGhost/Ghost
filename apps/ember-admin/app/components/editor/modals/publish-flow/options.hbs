<div class="gh-publish-title" data-test-publish-flow="options">
    <div class="green">Ready, set, publish.</div>
    <div>Share it with the world.</div>
</div>

{{#if @publishOptions.publishDisabledError}}
    <p class="gh-box gh-content-box pa" data-test-publish-type-error="publish-disabled">
        {{@publishOptions.publishDisabledError}}
    </p>
{{else}}
    <div class="gh-pubflow">

        <div class="gh-pubflow-row" data-test-setting="publish-web">
            {{svg-jar "globe-simple"}}
            <span class="gh-pubflow-row-label">Publish on the site</span>
            <div class="for-switch small">
                <label class="switch">
                    <input type="checkbox" checked={{this.webChecked}} {{on "change" this.toggleWeb}} data-test-checkbox="publish-web">
                    <span class="input-toggle-component"></span>
                </label>
            </div>
        </div>

        {{#unless @publishOptions.emailUnavailable}}
            <div class="gh-pubflow-row" data-test-setting="publish-email">
                {{svg-jar "send-email"}}
                <span class="gh-pubflow-row-label">Email to subscribers</span>
                <div class="for-switch small">
                    <label class="switch">
                        <input type="checkbox" checked={{this.emailChecked}} disabled={{@publishOptions.emailDisabled}} {{on "change" this.toggleEmail}} data-test-checkbox="publish-email">
                        <span class="input-toggle-component"></span>
                    </label>
                </div>
            </div>
            {{#if this.emailActive}}
                <div class="gh-pubflow-nest">
                    {{#if (gt @publishOptions.newsletters.length 1)}}
                        <div class="gh-pubflow-newsletter" data-test-select="newsletter">
                            <PowerSelect
                                @selected={{@publishOptions.newsletter}}
                                @options={{@publishOptions.newsletters}}
                                @onChange={{@publishOptions.setNewsletter}}
                                @triggerComponent={{component "gh-power-select/trigger"}}
                                @triggerClass="gh-publish-newsletter-trigger"
                                @dropdownClass="gh-publish-newsletter-dropdown"
                                as |newsletter|
                            >
                                <span data-test-select-option={{newsletter.name}}>{{newsletter.name}}</span>
                            </PowerSelect>
                        </div>
                    {{/if}}
                    <label class="gh-pubflow-radio" data-testid="send-standard">
                        <input type="radio" name="send-mode" checked={{eq this.sendMode "standard"}} {{on "change" this.useStandardSend}}>
                        {{#let (members-count-fetcher query=(hash filter=this.standardCountFilter)) as |countFetcher|}}
                            {{#if this.standardIsEveryone}}
                                All {{if countFetcher.isLoading "…" (format-number countFetcher.count)}} subscribers
                            {{else}}
                                {{if countFetcher.isLoading "…" (format-number countFetcher.count)}} subscribers &mdash; everyone the post or its preview is for
                            {{/if}}
                        {{/let}}
                    </label>
                    <label class="gh-pubflow-radio" data-testid="send-custom">
                        <input type="radio" name="send-mode" checked={{eq this.sendMode "custom"}} {{on "change" this.useCustomSend}}>
                        Only specific groups:
                    </label>
                    {{#if (eq this.sendMode "custom")}}
                        <div class="gh-pubflow-segments" data-test-select="segment-groups">
                            <GhSegmentTokenInput
                                @nonLabelOptions={{array}}
                                @selectedSegments={{this.selectedSegments}}
                                @onChange={{this.selectSegments}}
                                @renderInPlace={{false}}
                                @class="select-members select-members-recipient"
                                @dropdownClass="gh-publish-newsletter-dropdown"
                                @searchMessage="All groups selected"
                            />
                            {{#if this.customSelectionEmpty}}
                                <p class="gh-pubflow-hint">Pick at least one group, or switch back to all subscribers.</p>
                            {{/if}}
                        </div>
                    {{/if}}
                </div>
            {{/if}}
        {{/unless}}

        <div class="gh-pubflow-row gh-pubflow-row-when" data-test-setting="publish-at">
            {{svg-jar "clock"}}
            <div class="gh-pubflow-when">
                <Editor::PublishOptions::PublishAt @publishOptions={{@publishOptions}} />
            </div>
        </div>


    </div>

    {{#if @publishOptions.willEmail}}
        <Editor::EmailSizeWarning @post={{@publishOptions.post}} as |overLimit emailSizeKb| >
            {{#if overLimit}}
                <p class="gh-box gh-content-box pa gh-publish-setting-email-warning">
                    <div class="gh-email-preview-clip-title mb">This email is <span class="yellow-d1">{{emailSizeKb}}kB</span></div>
                    <div class="gh-email-preview-clip-description">Email newsletters may get clipped in the inbox behind a “View entire message” link when they’re over 100kB.</div>
                </p>
            {{/if}}
        </Editor::EmailSizeWarning>
    {{/if}}

    <div class="gh-publish-cta">
        <button type="button" class="gh-btn gh-btn-black gh-btn-large" disabled={{this.ctaBlocked}} {{on "click" @confirm}} data-test-button="continue">
            <span>Continue, final review &rarr;</span>
        </button>
    </div>
{{/if}}
