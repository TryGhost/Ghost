{{#if this.isStepped}}
    <div class="gh-publish-steps" data-test-publish-flow="confirm">
        <Editor::Modals::PublishFlow::StepDots @dots={{this.dots}} />

        <div class="gh-publish-step">
            {{! the question runs straight into the opening of the sentence the
                summary lines finish, so the review reads as one statement }}
            <h2 class="gh-publish-step-question" data-test-step-question>
                {{this.reviewHeading}} {{this.summaryLead}}
            </h2>

            <Editor::Modals::PublishFlow::ConfirmSummaryList
                @publishOptions={{@publishOptions}}
                @willPublish={{this.willPublish}}
                @siteSummary={{this.siteSummary}}
                @emailShape={{this.emailShape}}
                @newsletterSuffix={{this.newsletterSuffix}}
            />
        </div>

        {{#if this.errorMessage}}
            <p class="error gh-box gh-box-error mt3 mb3" data-test-confirm-error>
                {{this.errorMessage}}
            </p>
        {{/if}}

        <div class="gh-publish-cta">
            <GhTaskButton
                @task={{this.confirmTask}}
                @buttonText={{this.confirmButtonText}}
                @runningText={{this.confirmRunningText}}
                @successText={{this.confirmSuccessText}}
                @class="gh-btn gh-btn-large"
                @idleClass="gh-btn-pulse"
                @runningClass="gh-btn-green gh-btn-icon"
                @failureClass="gh-btn-red gh-btn-icon"
                data-test-button="confirm-publish"
            />
            <button type="button" class="gh-btn gh-btn-link gh-btn-large gh-publish-cta-secondary" {{on "click" @cancel}} data-test-button="back-to-options">Back</button>
        </div>
    </div>
{{else}}
    <div class="gh-publish-title" data-test-publish-flow="confirm">
        <div class="green">Ready, set, publish.</div>
        <div>Share it with the world.</div>
    </div>

    <Editor::Modals::PublishFlow::ConfirmSummary
        @publishOptions={{@publishOptions}}
        @recipientType={{@recipientType}}
        @willPublish={{this.willPublish}}
        @willEmail={{this.willEmail}}
        @previewAudience={{this.legacyPreviewAudience}}
        @hasPreview={{@publishOptions.post.hasPaywallCard}}
    />

    {{#if this.errorMessage}}
        <p class="error gh-box gh-box-error mt3 mb3" data-test-confirm-error>
            {{this.errorMessage}}
        </p>
    {{/if}}

    <div class="gh-publish-cta">
        <GhTaskButton
            @task={{this.confirmTask}}
            @buttonText={{this.confirmButtonText}}
            @runningText={{this.confirmRunningText}}
            @successText={{this.confirmSuccessText}}
            @class="gh-btn gh-btn-large"
            @idleClass="gh-btn-pulse"
            @runningClass="gh-btn-green gh-btn-icon"
            @failureClass="gh-btn-red gh-btn-icon"
            data-test-button="confirm-publish"
        />
        <button type="button" class="gh-btn gh-btn-link gh-btn-large gh-publish-cta-secondary" {{on "click" @cancel}} data-test-button="back-to-options">Back to settings</button>
    </div>
{{/if}}
