<div class="gh-publish-send-to {{if this.isSpecificChecked "mb4"}}">
    <div class="gh-publish-send-to-option">
        <div class="for-checkbox {{if @disabled "disabled"}}">
            <label class="checkbox" for="send-email-to-free">
                <input
                    id="send-email-to-free"
                    type="checkbox"
                    class="gh-input post-settings-featured"
                    checked={{this.isFreeChecked}}
                    disabled={{@disabled}}
                    aria-label="Free members toggle"
                    {{on "change" (fn this.toggleFilter "status:free")}}
                    data-test-checkbox="free-members"
                >
                <div class="flex">
                    <span class="input-toggle-component"></span>
                    <p>
                        Free
                        {{#let (members-count-fetcher query=(hash filter=(concat @newsletter.recipientFilter "+status:free"))) as |countFetcher|}}
                            {{#if (not (is-empty countFetcher.count))}}
                                <span class="gh-publish-emailcount" data-test-email-count="free-members">({{format-number countFetcher.count}})</span>
                            {{/if}}
                        {{/let}}
                        {{#if (and this.isFreeChecked @audienceOutcomes.free)}}
                            <span class="gh-publish-send-to-outcome" data-testid="audience-outcome-free">&mdash; {{@audienceOutcomes.free}}</span>
                        {{/if}}
                    </p>
                </div>
            </label>
        </div>
    </div>
    {{#if this.isPaidAvailable}}
        <div class="gh-publish-send-to-option">
            <div class="for-checkbox {{if @disabled "disabled"}}">
                <label class="checkbox" for="send-email-to-paid">
                    <input
                        id="send-email-to-paid"
                        type="checkbox"
                        class="gh-input post-settings-featured"
                        checked={{this.isPaidChecked}}
                        disabled={{@disabled}}
                        aria-label="Paid members toggle"
                        {{on "change" (fn this.toggleFilter "status:-free")}}
                        data-test-checkbox="paid-members"
                    >
                    <div class="flex">
                        <span class="input-toggle-component"></span>
                        <p>
                            Paid
                            {{#let (members-count-fetcher query=(hash filter=(concat @newsletter.recipientFilter "+status:-free"))) as |countFetcher|}}
                                {{#if (not (is-empty countFetcher.count))}}
                                    <span class="gh-publish-emailcount" data-test-email-count="paid-members">({{format-number countFetcher.count}})</span>
                                {{/if}}
                            {{/let}}
                            {{#if (and this.isPaidChecked @audienceOutcomes.paid)}}
                                <span class="gh-publish-send-to-outcome" data-testid="audience-outcome-paid">&mdash; {{@audienceOutcomes.paid}}</span>
                            {{/if}}
                        </p>
                    </div>
                </label>
            </div>
        </div>
    {{/if}}
    {{#if this.hasSpecificOptions}}
        <div class="gh-publish-send-to-option">
            <div class="for-checkbox {{if @disabled "disabled"}}">
                <label class="checkbox" for="send-email-to-specific">
                    <input
                        id="send-email-to-specific"
                        type="checkbox"
                        class="gh-input post-settings-featured"
                        checked={{this.isSpecificChecked}}
                        disabled={{@disabled}}
                        aria-label="Specific people toggle"
                        {{on "change" this.toggleSpecificFilter}}
                        data-test-checkbox="specific-members"
                    >
                    <div class="flex">
                        <span class="input-toggle-component"></span>
                        <p>Specific people</p>
                    </div>
                </label>
            </div>
        </div>
    {{/if}}
</div>
{{#if (and @paidSplit this.isPaidChecked)}}
    {{!-- tiers posts: the paid group mixes tiers with and without access,
          so its outcome is a computed split rather than a single label --}}
    <p class="gh-publish-send-to-mixed-outcome" data-testid="paid-outcome-split">
        {{#let (members-count-fetcher query=(hash filter=(concat @newsletter.recipientFilter "+(" @paidSplit.fullFilter ")"))) as |fullFetcher|}}
            {{#let (members-count-fetcher query=(hash filter=(concat @newsletter.recipientFilter "+(" @paidSplit.otherFilter ")"))) as |otherFetcher|}}
                Of paid subscribers, {{if fullFetcher.isLoading "…" (format-number fullFetcher.count)}} get the full post and {{if otherFetcher.isLoading "…" (format-number otherFetcher.count)}} {{@paidSplit.otherOutcome}}.
            {{/let}}
        {{/let}}
    </p>
{{/if}}
{{#if this.isSpecificChecked}}
    <div data-test-select="specific-members">
        <label class="gh-main-section-header small bn">Selection</label>
        <GhSegmentTokenInput
            @nonLabelOptions={{this.nonLabelOptions}}
            @selectedSegments={{this.selectedSpecificSegments}}
            @disabled={{@disabled}}
            @renderInPlace={{this.renderInPlace}}
            @onChange={{this.selectSpecificOptions}}
            @class="select-members select-members-recipient"
            @dropdownClass={{@dropdownClass}}
            @searchMessage="All labels selected"
        />
        {{!-- a specific selection can mix access levels, so the outcome is a
              computed split of the selection rather than a per-group label --}}
        {{#if (and @audienceOutcomes.free this.specificSegmentFilter)}}
            <p class="gh-publish-send-to-mixed-outcome" data-testid="specific-outcome-split">
                {{#let (members-count-fetcher query=(hash filter=(concat @newsletter.recipientFilter "+(" this.specificSegmentFilter ")+(status:-free)"))) as |fullFetcher|}}
                    {{#let (members-count-fetcher query=(hash filter=(concat @newsletter.recipientFilter "+(" this.specificSegmentFilter ")+(status:free)"))) as |previewFetcher|}}
                        Of these, {{if fullFetcher.isLoading "…" (format-number fullFetcher.count)}} get the full post and {{if previewFetcher.isLoading "…" (format-number previewFetcher.count)}} the public preview.
                    {{/let}}
                {{/let}}
            </p>
        {{/if}}
    </div>
{{/if}}
