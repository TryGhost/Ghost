# Node template

# Logs
logs/*
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
.ghost-dev
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
coverage*

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Typescript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Nx
.nxcache
.nx/cache
.nx/workspace-data

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# pnpm store
.pnpm-store

# dotenv environment variables file
.env
# Per-checkout ports and database for `pnpm dev`
.ghost-dev.env

# IDE
.idea/
*.iml
*.sublime-*
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json

# OSX
.DS_Store

!test/utils/fixtures/**/*.csv

# Ghost DB file
*.db
*.db-journal

/ghost/test-results/
/ghost/core/server/data/export/exported*
/ghost/content/tmp/*
/ghost/content/data/*
/ghost/content/logs/*
/ghost/content/settings/*
/ghost/content/apps/**/*
/ghost/content/themes/**/*
/ghost/content/images/**/*
/ghost/content/media/**/*
/ghost/content/files/**/*
/ghost/content/public/*
# Boot-generated public assets (admin-auth, .well-known) when tests use the
# fixtures dir as the content path — same as content/public above (PLA-152).
/ghost/test/utils/fixtures/public/
/ghost/content/adapters/storage/**/*
/ghost/content/adapters/scheduling/**/*
/ghost/content/themes/casper
/ghost/content/themes/source
!/ghost/README.md
!/ghost/content/**/README.md

# Changelog, which is autogenerated, not committed
/ghost/CHANGELOG.md

# Assets bundled into the release but we don't want to commit
/ghost/LICENSE
/ghost/PRIVACY.md
/ghost/README.md
/ghost/pnpm-lock.yaml

# Test generated files
test/functional/*.png

# ignore all custom json files for config
/ghost/config.*.json
/ghost/config.*.jsonc

# Build/deploy outputs
/ghost/package
/ghost/core/built
/ghost/core/frontend/public/ghost.min.css
/ghost/core/frontend/public/comment-counts.min.js
/ghost/core/frontend/public/member-attribution.min.js
/ghost/core/frontend/public/ghost-stats.min.js
/ghost/core/frontend/public/private.min.js
/ghost/core/frontend/public/cards.manifest.json
# Caddyfile - for local development with ssl + caddy
Caddyfile
!docker/dev-gateway/Caddyfile

# Playwright state with cookies it keeps across tests
/ghost/playwright-state.json
/ghost/playwright-report
/playwright-report
/test-results

# Admin
/apps/admin/test-results/

# Admin Toolbar
/apps/admin-toolbar/umd

# Comments-UI
/apps/comments-ui/umd
/apps/comments-ui/playwright-report
/ghost/comments-ui/playwright/.cache/
/apps/comments-ui/test-results/

# Portal
!/apps/portal/.env
/apps/portal/umd

# Sodo-Search
/apps/sodo-search/public/main.css
/apps/sodo-search/umd
/apps/sodo-search/.vitest-attachments
/apps/sodo-search/test/acceptance/__screenshots__

# Signup Form and local environments
/apps/signup-form/umd
/apps/signup-form/.env*.local
/apps/signup-form/test-results/
/apps/signup-form/playwright-report/
/apps/signup-form/playwright/.cache/

# Announcement-Bar
/apps/announcement-bar/umd
/apps/announcement-bar/.vitest-attachments
/apps/announcement-bar/test/acceptance/__screenshots__

# Build files
/apps/*/build
/ghost/*/build
/koenig/*/build
/packages/**/build
# Typescript build artifacts
tsconfig.tsbuildinfo

# Admin X

# Tinybird
.tinyb
.venv
.diff_tmp
temp*.sql

# Docker pnpm Cache
.pnpmhash

# yalc — for linking local packages in a docker compatible way
yalc.lock
.yalc

# A folder for AI generated files
# useful for keeping local plans etc
/ai

# Amp generates thread-specific portal state at runtime
/.amp/portals/

# direnv environment loader files
.envrc

# Private Claude Code instructions
*.local.md
.claude/settings.local.json
.mcp.local.json

# e2e test suite
/e2e/test-results
/e2e/playwright-report
/e2e/blob-report
/e2e/json-report
/e2e/shard-plan
/e2e/build
/e2e/playwright
/e2e/data
.env.tinybird
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

.nx/migrate-runs
